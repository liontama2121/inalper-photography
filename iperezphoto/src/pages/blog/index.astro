---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../lib/posts.js';
---

<Layout title="Blog — Detrás del Lente — IPEREZPHOTO" active="blog">
  <main id="blog">
    <div class="page-head reveal-group">
      <p class="eyebrow reveal">// Blog</p>
      <h1 class="h-display reveal">DETRÁS DEL LENTE</h1>
      <p class="sub reveal">Historias, técnica y proceso creativo.</p>
    </div>

    {posts.length === 0 ? (
      <section class="empty">
        <p class="empty-tag mono">[ Próximamente ]</p>
        <p class="empty-sub">Las primeras historias están en camino.</p>
      </section>
    ) : (
      <section class="post-list">
        {posts.map((p) => (
          <a class="post-card reveal" href={`/blog/${p.slug}`}>
            <div class="post-cover">{p.cover && <img src={p.cover} alt={p.title} loading="lazy" />}</div>
            <div class="post-meta">
              <span class="mono">{p.category} · {p.date}</span>
              <h3>{p.title}</h3>
            </div>
          </a>
        ))}
      </section>
    )}
  </main>
</Layout>

<style>
  #blog { min-height: 70vh; padding-bottom: 120px; }
  .sub { font-size: 15px; font-weight: 300; color: var(--muted); margin: 18px 0 0; }
  .empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 120px 24px; }
  .empty-tag { font-size: 10px; letter-spacing: 0.3em; color: var(--border); }
  .empty-sub { font-size: 14px; font-weight: 300; color: #2a2a2a; margin: 0; }

  .post-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 1280px; margin: 24px auto 0; padding: 0 40px; }
  .post-card { display: block; background: var(--deep); border: 1px solid var(--border); transition: border-color 0.3s ease; }
  .post-card:hover { border-color: var(--accent); }
  .post-cover { aspect-ratio: 16/9; background: var(--surface); overflow: hidden; }
  .post-cover img { width: 100%; height: 100%; object-fit: cover; }
  .post-meta { padding: 24px 28px; }
  .post-meta span { font-size: 9px; color: var(--accent); letter-spacing: 0.2em; }
  .post-meta h3 { font-family: var(--font-display); font-size: 28px; font-weight: 400; color: #fff; margin: 10px 0 0; }
  @media (max-width: 768px) { .post-list { grid-template-columns: 1fr; padding: 0 16px; } }
</style>
