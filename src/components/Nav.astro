---
import Icon from './Icon.astro';
import { WA_LINK } from '../lib/contact.js';

const { active = '' } = Astro.props;
const links = [
  { label: 'Portfolio', href: '/portfolio', key: 'portfolio' },
  { label: 'About', href: '/about', key: 'about' },
  { label: 'Blog', href: '/blog', key: 'blog' },
  { label: 'Contact', href: '/contact', key: 'contact' },
];
---

<nav id="nav" aria-label="Main">
  <a id="nav-logo" href="/" aria-label="IPEREZPHOTO, home">
    <img src="/IPEREZLOGO.png" alt="" width="148" height="44" />
  </a>

  <ul id="nav-links">
    {links.map((l) => (
      <li><a href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a></li>
    ))}
  </ul>

  <a id="nav-hire" class="btn btn-red" href={WA_LINK} target="_blank" rel="noopener">
    <Icon name="whatsapp" />Hire Inaldo
  </a>

  <button id="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer">
    <Icon name="list" size={26} />
  </button>
</nav>

<div id="nav-drawer" hidden>
  <button id="drawer-close" aria-label="Close menu"><Icon name="x" size={26} /></button>
  <ul>
    {links.map((l) => (
      <li><a href={l.href} class="bib-type" aria-current={active === l.key ? 'page' : undefined}>{l.label}</a></li>
    ))}
  </ul>
  <a class="btn btn-red drawer-hire" href={WA_LINK} target="_blank" rel="noopener"><Icon name="whatsapp" />Hire Inaldo</a>
</div>

<style>
  #nav {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--nav-h);
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 0 0 0 var(--gutter);
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  #nav-logo { margin-right: auto; display: block; }
  #nav-logo img { height: 34px; width: auto; }

  #nav-links { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  #nav-links a {
    position: relative;
    display: block;
    padding: 6px 0;
    font-size: 14px;
    font-weight: 600;
    font-stretch: 112%;
    text-transform: uppercase;
    color: var(--fg-2);
    transition: color 0.2s var(--ease-out);
  }
  #nav-links a:hover { color: var(--fg); }
  #nav-links a[aria-current='page'] { color: var(--fg); }
  #nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 3px;
    background: var(--red);
  }

  #nav-hire { height: var(--nav-h); min-height: 0; padding: 0 28px; }

  #nav-burger { display: none; width: var(--nav-h); height: var(--nav-h); background: none; border: 0; border-left: 1px solid var(--line); cursor: pointer; place-items: center; }

  #nav-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    background: var(--ink);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 var(--gutter);
  }
  #nav-drawer[hidden] { display: none; }
  #drawer-close { position: absolute; top: 0; right: 0; width: var(--nav-h); height: var(--nav-h); display: grid; place-items: center; background: none; border: 0; cursor: pointer; }
  #nav-drawer ul { list-style: none; margin: 0 0 40px; padding: 0; }
  #nav-drawer li a { display: block; padding: 6px 0; font-size: clamp(38px, 11vw, 64px); color: var(--fg-2); }
  #nav-drawer li a[aria-current='page'] { color: var(--fg); box-shadow: inset 0 -6px 0 var(--red); width: fit-content; }
  .drawer-hire { align-self: flex-start; }

  @media (max-width: 900px) {
    #nav { gap: 0; }
    #nav-links { display: none; }
    #nav-hire { padding: 0 18px; font-size: 13px; }
    #nav-burger { display: grid; }
  }
  @media (max-width: 400px) {
    #nav-logo img { height: 26px; }
    #nav-hire { padding: 0 14px; }
    #nav-hire :global(.ico) { display: none; }
  }
</style>

<script>
  import { animate, stagger } from 'animejs';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const burger = document.getElementById('nav-burger')!;
  const drawer = document.getElementById('nav-drawer')!;
  const closeBtn = document.getElementById('drawer-close')!;

  const setDrawer = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      drawer.hidden = false;
      closeBtn.focus();
      if (!reduce) {
        animate(drawer, { opacity: [0, 1], duration: 260, ease: 'outQuad' });
        animate(drawer.querySelectorAll('li, .drawer-hire'), { translateX: [-40, 0], opacity: [0, 1], duration: 600, delay: stagger(50), ease: 'outExpo' });
      }
    } else {
      drawer.hidden = true;
      burger.focus();
    }
  };
  burger.addEventListener('click', () => setDrawer(true));
  closeBtn.addEventListener('click', () => setDrawer(false));
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setDrawer(false)));
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) setDrawer(false); });
</script>
