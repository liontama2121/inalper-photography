---
// Camera HUD — animated Canon EOS viewfinder. SVG + vanilla JS + Anime.js.
---

<section id="hero">
  <!-- ===== SVG visor (z1) ===== -->
  <svg id="hud-svg" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="lensCoat" cx="42%" cy="40%" r="65%">
        <stop offset="0%" stop-color="#0a1a0f" />
        <stop offset="60%" stop-color="#05100a" />
        <stop offset="100%" stop-color="#020808" />
      </radialGradient>
    </defs>

    <!-- focus grid -->
    <g stroke-width="0.5">
      <line x1="960" y1="0" x2="960" y2="1080" stroke="rgba(255,255,255,0.025)" />
      <line x1="0" y1="540" x2="1920" y2="540" stroke="rgba(255,255,255,0.025)" />
      <line x1="640" y1="0" x2="640" y2="1080" stroke="rgba(255,255,255,0.012)" />
      <line x1="1280" y1="0" x2="1280" y2="1080" stroke="rgba(255,255,255,0.012)" />
      <line x1="0" y1="360" x2="1920" y2="360" stroke="rgba(255,255,255,0.012)" />
      <line x1="0" y1="720" x2="1920" y2="720" stroke="rgba(255,255,255,0.012)" />
    </g>

    <!-- framing brackets (L, 56px, offset 56) -->
    <g stroke="rgba(255,255,255,0.15)" stroke-width="1" fill="none">
      <path d="M56 112 V56 H112" />
      <path d="M1864 112 V56 H1808" />
      <path d="M56 968 V1024 H112" />
      <path d="M1864 968 V1024 H1808" />
    </g>

    <!-- lens -->
    <circle cx="960" cy="540" r="280" fill="none" stroke="rgba(255,255,255,0.04)" />
    <circle cx="960" cy="540" r="240" fill="url(#lensCoat)" />
    <circle cx="960" cy="540" r="160" fill="#000" />
    <ellipse cx="892" cy="472" rx="46" ry="20" fill="rgba(255,255,255,0.03)" transform="rotate(-30 892 472)" />

    <!-- aperture blades (JS-generated) -->
    <g id="aperture-blades"></g>

    <!-- AF points 3x3 (JS-generated) -->
    <g id="af-points"></g>

    <!-- scan line -->
    <line id="scan-line" x1="0" y1="0" x2="1920" y2="0" stroke="rgba(255,255,255,0.03)" stroke-width="1" />

    <!-- exposure scale (bottom center) -->
    <g id="exp-scale" font-family="JetBrains Mono, monospace" font-size="11" fill="rgba(255,255,255,0.06)" text-anchor="middle">
      <text x="780" y="940">-3</text><text x="840" y="940">-2</text><text x="900" y="940">-1</text>
      <text x="960" y="940">|</text>
      <text x="1020" y="940">+1</text><text x="1080" y="940">+2</text><text x="1140" y="940">+3</text>
      <rect id="exp-needle" x="957" y="948" width="2" height="10" fill="#cc0000" />
    </g>

    <!-- battery (top right) -->
    <g id="battery" transform="translate(1788 60)">
      <rect x="0" y="0" width="10" height="5" fill="rgba(255,255,255,0.28)" />
      <rect x="13" y="0" width="10" height="5" fill="rgba(255,255,255,0.28)" />
      <rect x="26" y="0" width="10" height="5" fill="rgba(255,255,255,0.28)" />
      <rect x="39" y="0" width="10" height="5" fill="rgba(255,255,255,0.28)" />
      <rect x="52" y="0" width="10" height="5" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="0.6" />
    </g>
  </svg>

  <!-- ===== HUD data (z2) ===== -->
  <div id="hud-data">
    <div class="hud tl">
      <span id="af-mode">AF-C · AI SERVO</span>
      <span id="af-sub" class="dim">SERVO</span>
    </div>
    <div class="hud tr">
      <span id="exp-read">1/4000  f/1.8  ISO 6400</span>
      <span id="frame-count" class="dim">[ 0847 ]</span>
    </div>
    <div class="hud bl">
      <span>BOGOTÁ · COLOMBIA</span>
      <span id="hud-date" class="dim">2025.01.01</span>
    </div>
    <div class="hud br">
      <span id="hud-aperture">⌀ f/1.8</span>
      <span class="dim">━━━·━━━</span>
    </div>
  </div>

  <!-- ===== hero text (z3) ===== -->
  <div id="hero-text">
    <p id="h-eyebrow" class="mono">Fotografía Deportiva · Bogotá, Colombia</p>
    <h1 class="h-name">
      <span class="hline" id="h-l1">INALDO</span>
      <span class="hline" id="h-l2">PÉREZ</span>
    </h1>
    <div id="h-sep"></div>
    <p id="h-media">AFP · El Tiempo · Caracol TV · RCN · El Heraldo</p>
    <a id="h-cta" class="mono" href="/portafolio">View Portfolio →</a>
  </div>

  <div id="hero-scroll">
    <span class="mono">Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  /* svh so the mobile URL bar can't push the hero taller than the screen */
  #hero { position: relative; height: 100vh; height: 100svh; min-height: 560px; background: var(--void); overflow: hidden; }
  #hud-svg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; opacity: 0; }

  #hud-data {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    font-family: var(--font-mono); text-transform: uppercase;
  }
  .hud { position: absolute; display: flex; flex-direction: column; gap: 5px; font-size: 11px; letter-spacing: 0.18em; color: rgba(255,255,255,0.2); }
  .hud .dim { font-size: 9px; color: rgba(255,255,255,0.08); }
  .hud.tl { top: 80px; left: 80px; }
  .hud.tr { top: 80px; right: 80px; text-align: right; align-items: flex-end; }
  .hud.bl { bottom: 80px; left: 80px; }
  .hud.br { bottom: 80px; right: 80px; text-align: right; align-items: flex-end; }

  /* Centered over the lens. Container is click-through so it never eats
     HUD area; only the CTA takes pointer events. */
  #hero-text {
    position: absolute; inset: 0; z-index: 3;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 0 24px; pointer-events: none;
  }
  #h-eyebrow { font-size: 10px; letter-spacing: 0.3em; color: var(--accent); margin: 0 0 26px; opacity: 0; }
  /* Fluid size: never smaller than legible, never wider than the viewport. */
  .h-name {
    font-family: var(--font-display); font-size: clamp(64px, 13.5vw, 210px);
    font-weight: 400; line-height: 0.85; letter-spacing: 0.02em; color: #fff; margin: 0;
  }
  .h-name .hline { display: block; opacity: 0; }
  #h-sep { width: 56px; height: 1px; background: var(--accent); margin: 26px auto; transform: scaleX(0); transform-origin: center; }
  #h-media { font-size: clamp(12px, 1.5vw, 15px); font-weight: 300; color: rgba(255,255,255,0.45); margin: 0 0 34px; opacity: 0; }
  #h-cta { display: inline-block; font-size: 11px; letter-spacing: 0.12em; color: #fff; border: 1px solid #fff; padding: 13px 32px; opacity: 0; transition: background 0.25s ease, color 0.25s ease; pointer-events: auto; }
  #h-cta:hover { background: #fff; color: var(--void); }

  #hero-scroll { position: absolute; right: 40px; bottom: 32px; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  #hero-scroll span { font-size: 8px; letter-spacing: 0.25em; color: #2a2a2a; writing-mode: vertical-rl; }
  .scroll-line { width: 1px; height: 44px; background: linear-gradient(to bottom, #2a2a2a, transparent); animation: spulse 2s ease-in-out infinite; }
  @keyframes spulse { 0%,100% { opacity: 0.3; transform: scaleY(1); } 50% { opacity: 1; transform: scaleY(0.6); } }

  /* hero bottom fade into page */
  #hero::after { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 160px; background: linear-gradient(to bottom, transparent, var(--void)); z-index: 2; pointer-events: none; }

  @media (max-width: 768px) {
    #hero-text { padding: 0 20px; }
    /* 16vw keeps PÉREZ edge-to-edge without overflowing narrow phones */
    .h-name { font-size: clamp(58px, 16vw, 96px); }
    #h-eyebrow { font-size: 9px; letter-spacing: 0.22em; margin: 0 0 20px; }
    #h-sep { margin: 20px auto; }
    #h-media { margin: 0 0 28px; line-height: 1.6; }
    #h-cta { padding: 14px 30px; }
    .hud.tl, .hud.bl, .hud.br { display: none; } /* keep only exposure top-right */
    .hud.tr { top: 76px; right: 20px; }
    #hero-scroll { right: 16px; bottom: 24px; }
  }

  /* very narrow phones — drop the scroll cue so it can't crowd the CTA */
  @media (max-width: 380px) {
    .h-name { font-size: 52px; }
    #hero-scroll { display: none; }
  }
</style>

<script>
  import { animate } from 'animejs';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CX = 960, CY = 540, N = 7;
  const bladesG = document.getElementById('aperture-blades')!;
  const TAU = Math.PI * 2;

  // f-stop -> opening radius (px). Bigger R = wider open.
  const F_TO_R: Record<string, number> = {
    'f/1.4': 152, 'f/1.8': 140, 'f/2.8': 116, 'f/4.0': 94, 'f/5.6': 72, 'f/8.0': 46,
  };

  // build 7 blade <path> elements
  const blades: SVGPathElement[] = [];
  for (let i = 0; i < N; i++) {
    const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    p.setAttribute('fill', 'rgba(10,10,10,0.92)');
    p.setAttribute('stroke', 'rgba(255,255,255,0.05)');
    p.setAttribute('stroke-width', '1');
    bladesG.appendChild(p);
    blades.push(p);
  }

  const pt = (ang: number, r: number) => `${(CX + Math.cos(ang) * r).toFixed(1)} ${(CY + Math.sin(ang) * r).toFixed(1)}`;

  // draw iris at opening radius R and swirl rotation
  function drawIris(R: number, swirl: number) {
    const OUT = 178;            // blades anchored at lens aperture edge
    const aw = (TAU / N) * 0.92; // half angular reach (overlap)
    for (let i = 0; i < N; i++) {
      const base = (i / N) * TAU - Math.PI / 2;
      const p1 = pt(base - aw, OUT);
      const p2 = pt(base + aw, OUT);
      const tip = pt(base + swirl, R);
      const c1 = pt(base - aw * 0.5 + swirl * 0.5, R + (OUT - R) * 0.45);
      const c2 = pt(base + aw * 0.5 + swirl * 0.5, R + (OUT - R) * 0.45);
      blades[i].setAttribute('d', `M ${p1} Q ${c1} ${tip} Q ${c2} ${p2} A ${OUT} ${OUT} 0 0 0 ${p1} Z`);
    }
  }

  // animated state
  const state = { R: F_TO_R['f/1.8'], swirl: 0.34 };
  const apReadout = document.getElementById('hud-aperture')!;
  function setAperture(f: string) {
    const targetR = F_TO_R[f] ?? 94;
    // closing -> more swirl
    const closeFrac = 1 - (targetR - 46) / (152 - 46);
    const targetSwirl = 0.18 + closeFrac * 0.5;
    apReadout.textContent = `⌀ ${f}`;
    if (reduce) { state.R = targetR; state.swirl = targetSwirl; drawIris(state.R, state.swirl); return; }
    animate(state, {
      R: targetR, swirl: targetSwirl, duration: 600, ease: 'inOutQuart',
      onUpdate: () => drawIris(state.R, state.swirl),
    });
  }
  drawIris(state.R, state.swirl);

  // ===== AF points 3x3 =====
  const afG = document.getElementById('af-points')!;
  const afRects: SVGRectElement[] = [];
  const gap = 150;
  for (let r = 0; r < 3; r++) {
    for (let c = 0; c < 3; c++) {
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('x', String(CX + (c - 1) * gap - 12));
      rect.setAttribute('y', String(CY + (r - 1) * gap - 7));
      rect.setAttribute('width', '24'); rect.setAttribute('height', '14');
      rect.setAttribute('fill', 'none'); rect.setAttribute('stroke-width', '0.8');
      const center = r === 1 && c === 1;
      rect.setAttribute('stroke', center ? 'rgba(204,0,0,0.45)' : 'rgba(255,255,255,0.08)');
      rect.dataset.center = center ? '1' : '0';
      afG.appendChild(rect); afRects.push(rect);
    }
  }
  // AF scan cycle every 5s
  function afCycle() {
    if (reduce) return;
    const outer = afRects.filter((r) => r.dataset.center === '0');
    const center = afRects.find((r) => r.dataset.center === '1')!;
    outer.forEach((r, i) => {
      setTimeout(() => {
        animate(r, { stroke: ['rgba(255,255,255,0.08)', 'rgba(255,255,255,0.6)', 'rgba(255,255,255,0.08)'], duration: 700, ease: 'inOutQuad' });
      }, i * 100);
    });
    setTimeout(() => {
      animate(center, { stroke: ['rgba(204,0,0,0.45)', 'rgba(204,0,0,1)', 'rgba(204,0,0,0.45)'], duration: 800, ease: 'inOutQuad' });
    }, 800);
  }
  afCycle();
  setInterval(afCycle, 5000);

  // ===== scan line (12s) =====
  const scan = document.getElementById('scan-line')!;
  if (!reduce) animate(scan, { y1: [0, 1080], y2: [0, 1080], duration: 12000, ease: 'linear', loop: true });

  // ===== exposure needle oscillation =====
  const needle = document.getElementById('exp-needle')!;
  if (!reduce) animate(needle, { x: [957 - 20, 957 + 20], duration: 4000, ease: 'inOutSine', loop: true, alternate: true });

  // ===== HUD rotating data =====
  const afModes = ['AF-C · AI SERVO', 'AF-S · ONE SHOT', 'MF · MANUAL', 'AF-C · SPORTS'];
  const afSubs = ['SERVO', 'ONE SHOT', 'MANUAL', 'SPORTS'];
  const expSets = [
    { read: '1/4000  f/1.8  ISO 6400', f: 'f/1.8' },
    { read: '1/500   f/4.0  ISO 800',  f: 'f/4.0' },
    { read: '1/1000  f/2.8  ISO 3200', f: 'f/2.8' },
    { read: '1/250   f/5.6  ISO 400',  f: 'f/5.6' },
  ];
  const afModeEl = document.getElementById('af-mode')!;
  const afSubEl = document.getElementById('af-sub')!;
  const expEl = document.getElementById('exp-read')!;
  const fcEl = document.getElementById('frame-count')!;

  const fade = (el: Element, txt: string) => {
    if (reduce) { el.textContent = txt; return; }
    animate(el, { opacity: [1, 0], duration: 250, ease: 'outQuad', onComplete: () => {
      el.textContent = txt;
      animate(el, { opacity: [0, 1], duration: 250, ease: 'outQuad' });
    }});
  };

  let afI = 0;
  setInterval(() => { afI = (afI + 1) % afModes.length; fade(afModeEl, afModes[afI]); afSubEl.textContent = afSubs[afI]; }, 4000);

  let expI = 0;
  setInterval(() => {
    expI = (expI + 1) % expSets.length;
    fade(expEl, expSets[expI].read);
    setAperture(expSets[expI].f); // diaphragm reacts to exposure set
  }, 3000);

  // frame counter random every 5s
  setInterval(() => {
    const n = String(Math.floor(1 + (performance.now() % 9998))).padStart(4, '0');
    fcEl.textContent = `[ ${n} ]`;
  }, 5000);

  // dynamic date
  const d = new Date();
  document.getElementById('hud-date')!.textContent =
    `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

  // ===== entrance choreography =====
  const E = 'outQuart';
  if (reduce) {
    document.getElementById('hud-svg')!.style.opacity = '1';
    ['h-eyebrow', 'h-l1', 'h-l2', 'h-media', 'h-cta'].forEach((id) => (document.getElementById(id)!.style.opacity = '1'));
    document.getElementById('h-sep')!.style.transform = 'scaleX(1)';
  } else {
    animate('#hud-svg', { opacity: [0, 1], duration: 2000, ease: E });
    animate('#h-eyebrow', { translateY: [-8, 0], opacity: [0, 1], delay: 400, duration: 600, ease: E });
    animate('#h-l1', { translateY: [22, 0], opacity: [0, 1], delay: 600, duration: 700, ease: E });
    animate('#h-l2', { translateY: [22, 0], opacity: [0, 1], delay: 750, duration: 700, ease: E });
    animate('#h-sep', { scaleX: [0, 1], delay: 900, duration: 500, ease: E });
    animate('#h-media', { opacity: [0, 1], delay: 1100, duration: 600, ease: E });
    animate('#h-cta', { translateY: [8, 0], opacity: [0, 1], delay: 1300, duration: 600, ease: E });
  }
</script>
