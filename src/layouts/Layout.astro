---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Shutter from '../components/Shutter.astro';
import { WA_LINK } from '../lib/contact.js';

const {
  title = 'Inaldo Pérez | Sports Photographer',
  description = 'Sports photography by Inaldo Pérez. Published by AFP, El Tiempo, Caracol TV, RCN and El Heraldo. Bogotá, Colombia.',
  active = '',
  ogImage = '/IPEREZLOGO.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0b0c" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/IPEREZLOGO.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Martian+Mono:wdth,wght@87.5,500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Hide reveal targets only when JS runs and motion is allowed.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
        // Came through the page shutter: paint closed, Shutter.astro opens it.
        try { if (sessionStorage.getItem('shutter')) { sessionStorage.removeItem('shutter'); document.documentElement.classList.add('shutter-closed'); setTimeout(() => document.documentElement.classList.remove('shutter-closed'), 2500); } } catch {}
      }
    </script>
  </head>

  <body>
    <Nav active={active} />

    <slot />

    <Footer />

    <Shutter />

    <a id="wa-float" href={WA_LINK} target="_blank" rel="noopener" aria-label="Hire Inaldo on WhatsApp">
      <Icon name="whatsapp" />
    </a>

    <script>
      import { animate, stagger } from 'animejs';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- Floating WhatsApp: hidden while an on-page hire CTA is visible ----
      const wa = document.getElementById('wa-float')!;
      const hires = document.querySelectorAll('[data-hire]');
      const onScreen = new Set<Element>();
      let shown = false;
      const setWa = (show: boolean) => {
        if (show === shown) return;
        shown = show;
        wa.classList.toggle('visible', show);
        if (reduce) { wa.style.opacity = show ? '1' : '0'; return; }
        animate(wa, show
          ? { opacity: [0, 1], translateY: [16, 0], duration: 420, ease: 'outExpo' }
          : { opacity: 0, translateY: 16, duration: 220, ease: 'outQuad' });
      };
      const hireIo = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? onScreen.add(e.target) : onScreen.delete(e.target)));
        setWa(onScreen.size === 0);
      });
      setTimeout(() => {
        if (hires.length) hires.forEach((h) => hireIo.observe(h));
        else setWa(true);
      }, 1200);

      // ---- Global scroll-reveal, grouped so siblings stagger together ----
      if (!reduce) {
        const els = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
        const groups = new Map<Element, HTMLElement[]>();
        els.forEach((el) => {
          const key = el.closest('.reveal-group') || el.closest('section, footer, main') || document.body;
          if (!groups.has(key)) groups.set(key, []);
          groups.get(key)!.push(el);
        });
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animate(groups.get(entry.target) || [], {
              translateY: [32, 0], opacity: [0, 1], duration: 900, ease: 'outExpo', delay: stagger(70),
            });
            io.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        groups.forEach((_, key) => io.observe(key));
      }
    </script>
  </body>
</html>
