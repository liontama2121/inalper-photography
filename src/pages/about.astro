---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { PRESS, EVENTS } from '../lib/credentials.js';
import { zones, bodies } from '../lib/photos.js';
import { WA_LINK } from '../lib/contact.js';
import fs from 'node:fs';
import path from 'node:path';
const hasPortrait = fs.existsSync(path.join(process.cwd(), 'public', 'inaldo-portrait.jpg'));
// Most-used bodies straight from the photos' EXIF.
const gear = bodies.filter((b) => b.cam.startsWith('Canon')).slice(0, 3).map((b) => b.cam.replace(/^Canon /, ''));
const sports = zones.filter((z) => !['eventos', 'paisajes', 'naturaleza'].includes(z.cat));
---

<Layout title="About | Inaldo Pérez, Sports Photographer" active="about">
  <main id="about">
    <div class="wrap about-grid">
      <article id="cred" aria-label="Press credential">
        <p class="cred-band bib-type">Photo</p>
        <div class="cred-body">
          <div class="cred-photo">
            {hasPortrait ? <img src="/inaldo-portrait.jpg" alt="Inaldo Pérez" width="1440" height="1440" /> : <div class="cred-ph" />}
          </div>
          <div class="cred-id">
            <p class="cred-name bib-type">Inaldo<br />Pérez</p>
            <p class="cred-role">Sports photographer</p>
            <dl class="cred-fields">
              <div><dt>Base</dt><dd>Los Angeles, California</dd></div>
              <div><dt>Active</dt><dd>10+ years</dd></div>
              <div><dt>Disciplines</dt><dd>15+</dd></div>
              <div><dt>Media</dt><dd>{PRESS.slice(0, 3).join(', ')}</dd></div>
              {gear.length > 0 && <div><dt>Canon bodies</dt><dd>{gear.join(', ')}</dd></div>}
            </dl>
          </div>
        </div>
        <ul class="cred-zones" aria-label="Zones on file">
          {sports.map((z) => <li class="data" title={z.label}>{z.code}</li>)}
        </ul>
      </article>

      <div class="bio reveal-group">
        <h1 class="bib-type reveal">More than a decade at the edge of the field</h1>
        <p class="reveal">Based in Los Angeles, California. Sports photographer with more than a decade capturing the most intense moments of Colombian and international sport. Specialized in action photography, his work has been published by the country’s leading agencies and media outlets.</p>
        <p class="reveal">From the South American Games to the World Games, his lens has documented more than 15 sporting disciplines with an eye that pairs technical precision with visual storytelling.</p>
        <a class="btn btn-red reveal" href={WA_LINK} target="_blank" rel="noopener" data-hire><Icon name="whatsapp" />Hire Inaldo</a>
      </div>
    </div>

    <section class="wrap zones-sec" aria-labelledby="zones-h">
      <h2 id="zones-h" class="code-type reveal">On file</h2>
      <ul class="zone-grid reveal-group">
        {zones.map((z) => (
          <li class="reveal">
            <a href={`/portfolio#${z.cat}`} class="zg-cell">
              <span class="zg-code code-type">{z.code}</span>
              <span class="zg-label">{z.label}</span>
              <span class="zg-n data">{z.count} frames</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap events-sec" aria-labelledby="ev-h">
      <h2 id="ev-h" class="code-type ev-h reveal">Coverage</h2>
      <ul class="ev-list reveal-group">
        {EVENTS.map((e) => (
          <li class="reveal"><span class="ev-title bib-type">{e.title}</span><span class="ev-desc">{e.desc}</span></li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  #about { padding-bottom: clamp(96px, 12vw, 160px); }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(320px, 440px) 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    padding-top: calc(var(--nav-h) + clamp(40px, 6vw, 88px));
  }

  /* ===== Credential card ===== */
  #cred { background: var(--fg); color: var(--ink); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5); position: sticky; top: calc(var(--nav-h) + 24px); }
  .cred-band { padding: 14px 20px 8px; background: var(--red); color: var(--on-red); font-size: 56px; letter-spacing: 0.04em; }
  .cred-body { display: grid; grid-template-columns: 0.9fr 1fr; gap: 18px; padding: 20px; }
  .cred-photo img, .cred-ph { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; background: #d6d6d2; }
  .cred-name { font-size: 30px; }
  .cred-role { margin: 6px 0 14px; font-size: 13px; font-weight: 700; text-transform: uppercase; color: #3a3a3e; }
  .cred-fields { margin: 0; display: grid; gap: 8px; }
  .cred-fields div { display: grid; gap: 1px; }
  .cred-fields dt { font-family: var(--font-data); font-size: 10px; text-transform: uppercase; color: #55555b; }
  .cred-fields dd { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.3; }
  .cred-zones { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; margin: 0; padding: 0 20px 20px; }
  .cred-zones li { padding: 4px 6px; background: var(--ink); color: var(--fg); font-size: 11px; }

  /* ===== Bio ===== */
  .bio h1 { font-size: clamp(32px, 3.6vw, 56px); margin-bottom: 32px; max-width: 18ch; }
  .bio p { max-width: 62ch; margin: 0 0 22px; font-size: clamp(17px, 1.35vw, 19px); line-height: 1.7; color: var(--fg-2); }
  .bio .btn { margin-top: 12px; }

  /* ===== Zones on file: bento of discipline codes ===== */
  .zones-sec { padding-top: clamp(96px, 12vw, 160px); }
  .zones-sec h2 { font-size: clamp(64px, 12vw, 180px); margin-bottom: 28px; }
  .zone-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1px; }
  .zone-grid li { outline: 1px solid var(--line); }
  .zg-cell { display: grid; gap: 4px; height: 100%; padding: 20px; background: var(--ink); transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out); }
  .zg-code { font-size: 56px; }
  .zg-label { font-weight: 700; text-transform: uppercase; font-size: 14px; }
  .zg-n { color: var(--fg-3); }
  .zg-cell:hover { background: var(--red); color: var(--on-red); }
  .zg-cell:hover .zg-n { color: var(--on-red); }

  /* ===== Featured coverage ===== */
  .events-sec { padding-top: clamp(80px, 10vw, 128px); }
  .ev-h { font-size: clamp(64px, 12vw, 180px); margin-bottom: 28px; }
  .ev-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 40px; }
  .ev-list li { display: grid; gap: 12px; padding-top: 20px; border-top: 3px solid var(--fg); }
  .ev-list li:first-child { border-top-color: var(--red); }
  .ev-title { font-size: clamp(22px, 2.2vw, 30px); }
  .ev-desc { color: var(--fg-2); }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    #cred { position: static; max-width: 460px; }
    .ev-list { grid-template-columns: 1fr; gap: 28px; }
    .zone-grid { grid-template-columns: repeat(2, 1fr); }
    .zg-code { font-size: 44px; }
  }
  @media (max-width: 420px) {
    .cred-body { grid-template-columns: 1fr 1.1fr; gap: 14px; padding: 16px; }
    .cred-name { font-size: 24px; }
    .cred-band { font-size: 44px; }
  }
</style>

<script>
  import { animate } from 'animejs';
  // Issue the credential: card rises, red band prints across.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    animate('#cred', { translateY: [60, 0], rotate: [-2.5, 0], duration: 1100, ease: 'outExpo' });
    animate('#cred .cred-band', { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'], delay: 250, duration: 700, ease: 'outExpo' });
    animate('#cred .cred-zones li', { opacity: [0, 1], delay: (_, i) => 600 + i * 35, duration: 200, ease: 'linear' });
  }
</script>
