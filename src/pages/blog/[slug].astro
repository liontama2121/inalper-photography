---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../lib/posts.js';

export function getStaticPaths() {
  // Empty until content is connected (Cloudflare R2 / CMS).
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
---

<Layout title={`${post.title} | Inaldo Pérez`} description={post.title} active="blog" ogImage={post.cover}>
  <article id="post">
    <header class="wrap post-hero">
      <p class="post-meta data">{post.category}, {post.date}, {post.readTime} read</p>
      <h1 class="bib-type">{post.title}</h1>
    </header>
    {post.cover && <img class="post-cover" src={post.cover} alt="" />}
    <div class="wrap">
      <div class="post-body" set:html={post.body} />
    </div>
  </article>
</Layout>

<style>
  #post { padding-bottom: clamp(96px, 12vw, 160px); }
  .post-hero { padding-top: calc(var(--nav-h) + clamp(48px, 8vw, 104px)); padding-bottom: 40px; }
  .post-meta { margin: 0 0 20px; color: var(--fg-3); }
  .post-hero h1 { font-size: clamp(36px, 6vw, 88px); max-width: 18ch; }
  .post-cover { width: 100%; max-height: 80dvh; object-fit: cover; background: var(--panel); }
  .post-body { max-width: 68ch; margin: 56px auto 0; font-size: 19px; line-height: 1.8; color: var(--fg-2); }
  .post-body :global(p) { margin: 0 0 28px; }
  .post-body :global(h2) { font-weight: 900; font-stretch: 112%; text-transform: uppercase; font-size: 30px; line-height: 1.1; color: var(--fg); margin: 56px 0 18px; }
  .post-body :global(a) { color: var(--fg); text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
  .post-body :global(img) { margin: 40px 0; }
</style>
