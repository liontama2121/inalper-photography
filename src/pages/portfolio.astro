---
import Layout from '../layouts/Layout.astro';
import ZoneRow from '../components/ZoneRow.astro';
import Lightbox from '../components/Lightbox.astro';
import { photos, zones } from '../lib/photos.js';

// Only this many thumbnails ship with a src; "Load more" wires up the rest.
const BATCH = 24;
const items = photos.map((p) => ({ src: p.src, label: p.label, code: p.code, n: p.n, of: p.of, caption: p.caption, shot: p.shot }));
---

<Layout title="Portfolio | Inaldo Pérez, Sports Photographer" active="portfolio">
  <main id="portfolio">
    <header class="wrap page-head reveal-group">
      <h1 class="bib-type reveal">The work</h1>
      <p class="lede reveal">{photos.length} frames from {zones.length} zones. Pick a discipline to see it alone.</p>
    </header>

    <div id="filter-bar">
      <ZoneRow id="pf-zones" zones={zones} total={photos.length} />
    </div>

    <section id="gal" aria-label="Photographs">
      <div id="gal-grid">
        {photos.map((p, i) => (
          <button class={`photo${i < BATCH ? '' : ' pending'}`} data-i={i} data-cat={p.cat} aria-label={`${p.label}, frame ${p.n} of ${p.of}. Open`}>
            <img src={i < BATCH ? p.md : undefined} data-src={p.md} alt="" width={p.w} height={p.h} loading="lazy" decoding="async" />
            <span class="ph-tag"><span class="ph-code">{p.code}</span><span class="data">{String(p.n).padStart(3, '0')}</span></span>
          </button>
        ))}
      </div>

      <div id="gal-more">
        <button id="load-more" class="btn btn-line">Load more <span id="more-count" class="data"></span></button>
      </div>
    </section>

    <script type="application/json" id="pf-items" set:html={JSON.stringify(items)} />
  </main>

  <Lightbox />
</Layout>

<style>
  #portfolio { padding-bottom: 120px; }
  #filter-bar { position: sticky; top: var(--nav-h); z-index: 20; }

  #gal { padding: 4px var(--gutter) 0; }
  #gal-grid { column-count: 4; column-gap: 4px; }
  .photo {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 4px;
    padding: 0;
    border: 0;
    break-inside: avoid;
    overflow: hidden;
    background: var(--panel);
    cursor: zoom-in;
  }
  .photo img { width: 100%; height: auto; transition: transform 0.6s var(--ease-out); }
  .photo:hover img { transform: scale(1.03); }
  .photo.pending, .photo.hide { display: none; }

  /* Zone code tag: hidden until hover/focus, a bib corner on the frame */
  .ph-tag {
    position: absolute;
    left: 0; bottom: 0;
    display: flex; align-items: baseline; gap: 8px;
    padding: 6px 10px 4px;
    background: var(--red);
    color: var(--on-red);
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.25s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .ph-code { font-weight: 900; font-stretch: 62%; font-size: 22px; line-height: 1; }
  .photo:hover .ph-tag, .photo:focus-visible .ph-tag { opacity: 1; transform: none; }
  .photo:focus-visible { outline-offset: -2px; }

  #gal-more { display: flex; justify-content: center; padding-top: 48px; }
  #load-more[hidden] { display: none; }
  #more-count { color: var(--fg-3); }

  @media (max-width: 1200px) { #gal-grid { column-count: 3; } }
  @media (max-width: 860px) { #gal-grid { column-count: 2; } }
  @media (max-width: 480px) { #gal { padding: 4px 4px 0; } #gal-grid { column-gap: 3px; } .photo { margin-bottom: 3px; } }
</style>

<script>
  import { animate } from 'animejs';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const BATCH = 24;
  const items = JSON.parse(document.getElementById('pf-items')!.textContent || '[]');
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('#gal-grid .photo'));
  const moreBtn = document.getElementById('load-more') as HTMLButtonElement;
  const moreCount = document.getElementById('more-count')!;
  const zoneBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#pf-zones .zone'));
  let cat = 'all';

  const inCat = (t: HTMLElement) => cat === 'all' || t.dataset.cat === cat;
  const pending = (t: HTMLElement) => t.classList.contains('pending');

  function updateMore() {
    const left = tiles.filter((t) => inCat(t) && pending(t)).length;
    moreBtn.hidden = left === 0;
    moreCount.textContent = left ? `(${left})` : '';
  }

  function enter(list: HTMLElement[]) {
    if (reduce || !list.length) return;
    animate(list, { opacity: [0, 1], translateY: [24, 0], duration: 700, delay: (_, i) => Math.min(i, 24) * 30, ease: 'outExpo' });
  }

  function revealMore(n: number) {
    const batch = tiles.filter((t) => inCat(t) && pending(t)).slice(0, n);
    batch.forEach((t) => {
      const img = t.querySelector('img')!;
      if (!img.getAttribute('src')) img.src = img.dataset.src!;
      t.classList.remove('pending');
    });
    enter(batch);
    updateMore();
  }
  moreBtn.addEventListener('click', () => revealMore(BATCH));

  zoneBtns.forEach((btn) => btn.addEventListener('click', () => {
    cat = btn.dataset.cat || 'all';
    zoneBtns.forEach((b) => { const on = b === btn; b.classList.toggle('active', on); b.setAttribute('aria-pressed', String(on)); });
    const shown: HTMLElement[] = [];
    tiles.forEach((t) => {
      if (pending(t)) return;
      const on = inCat(t);
      t.classList.toggle('hide', !on);
      if (on) shown.push(t);
    });
    if (shown.length < BATCH) revealMore(BATCH - shown.length);
    enter(shown.slice(0, 24));
    updateMore();
    const bar = document.getElementById('filter-bar')!;
    if (bar.getBoundingClientRect().top > 70) return;
    window.scrollTo({ top: document.getElementById('gal')!.offsetTop - 140, behavior: reduce ? 'auto' : 'smooth' });
  }));

  tiles.forEach((t) => t.addEventListener('click', () => {
    const list = tiles.filter((x) => !x.classList.contains('hide') && !pending(x));
    const sub = list.map((x) => items[Number(x.dataset.i)]);
    window.dispatchEvent(new CustomEvent('lb:open', { detail: { items: sub, index: list.indexOf(t), opener: t } }));
  }));

  updateMore();
  // /portfolio#natacion opens straight on that zone (links from About).
  zoneBtns.find((b) => location.hash && b.dataset.cat === decodeURIComponent(location.hash.slice(1)))?.click();
</script>
