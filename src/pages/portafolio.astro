---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Pretty labels + preferred order for known categories.
const LABELS = {
  rugby: 'Rugby', atletismo: 'Atletismo', natacion: 'Natación', taekwondo: 'Taekwondo',
  gimnasia: 'Gimnasia', surf: 'Surf', ciclismo: 'Ciclismo', boxeo: 'Boxeo',
  basketball: 'Basketball', futbol: 'Fútbol', patinaje: 'Patinaje', halterofilia: 'Halterofilia',
  esgrima: 'Esgrima', 'juegos-mundiales': 'Juegos Mundiales', eventos: 'Eventos',
  paisajes: 'Paisajes', naturaleza: 'Naturaleza',
};
const ORDER = Object.keys(LABELS);
const prettify = (s) => LABELS[s] || s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const IMG_RE = /\.(jpe?g|png|webp|avif)$/i;
const photosDir = path.join(process.cwd(), 'public', 'photos');

// Scan every category folder for real images at build time.
let scanned = [];
if (fs.existsSync(photosDir)) {
  for (const dir of fs.readdirSync(photosDir)) {
    const full = path.join(photosDir, dir);
    if (!fs.statSync(full).isDirectory()) continue;
    const files = fs.readdirSync(full).filter((f) => IMG_RE.test(f)).sort();
    if (files.length === 0) continue;
    scanned.push({ cat: dir, count: files.length, files });
  }
}
// Order: known cats first (ORDER), unknown appended alphabetically.
scanned.sort((a, b) => {
  const ia = ORDER.indexOf(a.cat), ib = ORDER.indexOf(b.cat);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.cat.localeCompare(b.cat);
});

const categories = [{ cat: 'todas', label: 'Todas' }, ...scanned.map((s) => ({ cat: s.cat, label: prettify(s.cat) }))];

// Flat list of all photos, in category order.
const photos = scanned.flatMap((s) =>
  s.files.map((f) => ({ cat: s.cat, label: prettify(s.cat), src: `/photos/${s.cat}/${encodeURIComponent(f)}` }))
);
const totalPhotos = photos.length;

// Only this many <img src> ship in the HTML; the rest carry data-src and are
// wired up by the "load more" button. 574 photos at once made the page crawl.
const BATCH = 12;
---

<Layout title="Portafolio — IPEREZPHOTO" active="portafolio">
  <main id="portafolio">
    <div class="page-head reveal-group">
      <p class="eyebrow reveal">// Portafolio</p>
      <h1 class="h-display reveal">EL TRABAJO</h1>
    </div>

    <!-- ===== Category nav ===== -->
    <nav id="cat-nav">
      <div id="cat-list">
        {categories.map((c, i) => (
          <button class={`cat-btn${i === 0 ? ' active' : ''}`} data-cat={c.cat}>{c.label}</button>
        ))}
      </div>
    </nav>

    <!-- ===== Masonry gallery ===== -->
    <section id="gal">
      <div id="gal-grid">
        {photos.map((p, i) => (
          <figure class={`photo-item${i < BATCH ? '' : ' pending'}`} data-cat={p.cat}>
            <img
              src={i < BATCH ? p.src : undefined}
              data-src={p.src}
              alt={`${p.label} — Inaldo Pérez`}
              loading="lazy"
              decoding="async"
            />
            <div class="photo-ov">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="1"><path d="M12 5v14M5 12h14" /></svg>
              <span class="photo-cat mono" data-label={p.label}>{p.label}</span>
            </div>
          </figure>
        ))}
      </div>

      <div id="gal-more">
        <button id="load-more" class="mono">Cargar más <span id="more-count"></span></button>
      </div>
    </section>
  </main>

  <!-- ===== Lightbox ===== -->
  <div id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <button id="lb-close" aria-label="Cerrar"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M5 5l14 14M19 5L5 19" /></svg></button>
    <button id="lb-prev" class="lb-nav" aria-label="Anterior"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M15 5l-8 7 8 7" /></svg></button>
    <figure id="lb-stage"><img id="lb-img" alt="" /><div id="lb-ph"><span class="mono">Próximamente</span></div></figure>
    <button id="lb-next" class="lb-nav" aria-label="Siguiente"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M9 5l8 7-8 7" /></svg></button>
    <div id="lb-bar" class="mono"><span id="lb-meta"></span><span id="lb-count"></span></div>
  </div>
</Layout>

<style>
  #portafolio { padding-bottom: 100px; }

  /* ===== Category nav ===== */
  /* Wraps instead of scrolling: with 18 categories a single strip ran wider
     than the viewport and the overflow was invisible (no scrollbar shown). */
  #cat-nav {
    margin: 40px 0 32px;
    border-bottom: 1px solid #1a1a1a;
    padding: 0 40px;
  }

  #cat-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .cat-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #444444;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
    margin-bottom: -1px;
  }
  .cat-btn:hover { color: #888888; }
  .cat-btn.active {
    color: #ffffff;
    border-bottom-color: #cc0000;
  }

  /* ===== Gallery ===== */
  #gal { padding: 24px 40px 0; }
  #gal-grid { column-count: 3; column-gap: 3px; }
  .photo-item { position: relative; margin: 0 0 3px; break-inside: avoid; overflow: hidden; cursor: crosshair; background: var(--surface); }
  .photo-item img { width: 100%; height: auto; display: block; }
  .photo-ov { position: absolute; inset: 0; background: rgba(8,8,8,0); display: flex; align-items: center; justify-content: center; pointer-events: none; transition: background 0.25s ease; }
  .photo-ov svg { opacity: 0; transition: opacity 0.25s ease; }
  .photo-cat { position: absolute; left: 10px; bottom: 10px; font-size: 9px; color: #fff; opacity: 0; transition: opacity 0.25s ease; }
  .photo-item:hover .photo-ov { background: rgba(8,8,8,0.65); }
  .photo-item:hover .photo-ov svg, .photo-item:hover .photo-cat { opacity: 1; }
  .photo-item.hide { display: none; }
  /* not yet requested — the img has no src until "load more" assigns it */
  .photo-item.pending { display: none; }

  #gal-more { display: flex; justify-content: center; padding: 48px 40px 0; }
  #load-more {
    background: none; border: 1px solid var(--border); color: #fff;
    font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; padding: 16px 40px; cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  #load-more:hover { background: #fff; color: var(--void); border-color: #fff; }
  #load-more[hidden] { display: none; }
  #more-count { color: #555; margin-left: 6px; }
  #load-more:hover #more-count { color: var(--void); }

  @media (max-width: 1024px) { #gal-grid { column-count: 2; } }
  @media (max-width: 768px) {
    .page-head { padding-top: 120px; }
    #cat-nav { padding: 0 10px; }
    /* tighter cells so every category fits on screen; 40px min touch height */
    .cat-btn { padding: 12px 11px; font-size: 9px; letter-spacing: 0.1em; }
    #gal { padding: 16px 16px 0; }
    #gal-grid { column-count: 1; column-gap: 2px; }
  }

  @media (max-width: 420px) {
    .cat-btn { padding: 11px 9px; letter-spacing: 0.06em; }
  }

  /* ===== Lightbox ===== */
  #lightbox { position: fixed; inset: 0; z-index: 999; background: rgba(0,0,0,0.97); display: none; align-items: center; justify-content: center; opacity: 0; }
  #lightbox.open { display: flex; }
  #lb-stage { margin: 0; display: flex; align-items: center; justify-content: center; }
  #lb-img { max-width: 90vw; max-height: 88vh; object-fit: contain; display: none; }
  #lb-ph { width: min(70vw, 540px); aspect-ratio: 3/2; background: var(--surface); display: flex; align-items: center; justify-content: center; }
  #lb-ph span { font-size: 9px; color: #444; }
  #lb-close { position: fixed; top: 24px; right: 28px; background: none; border: none; color: #fff; cursor: pointer; transition: color 0.2s; }
  .lb-nav { position: fixed; top: 50%; transform: translateY(-50%); background: none; border: none; color: #fff; cursor: pointer; padding: 16px; transition: color 0.2s; }
  #lb-prev { left: 24px; } #lb-next { right: 24px; }
  #lb-close:hover, .lb-nav:hover { color: var(--accent); }
  #lb-bar { position: fixed; bottom: 28px; left: 0; width: 100%; padding: 0 40px; display: flex; justify-content: space-between; font-size: 10px; color: #444; }
  @media (max-width: 768px) { .lb-nav { display: none; } }
</style>

<script>
  import { animate } from 'animejs';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ===== Batched loading =====
  // Photos past the first batch ship without a src, so the browser never
  // requests them until the visitor asks for more.
  const BATCH = 12;
  const photos = Array.from(document.querySelectorAll<HTMLElement>('.photo-item'));
  const moreBtn = document.getElementById('load-more') as HTMLButtonElement;
  const moreCount = document.getElementById('more-count')!;
  let currentCat = 'todas';

  const inCat = (p: HTMLElement) => currentCat === 'todas' || p.dataset.cat === currentCat;
  const isPending = (p: HTMLElement) => p.classList.contains('pending');

  function updateMoreBtn() {
    const left = photos.filter((p) => inCat(p) && isPending(p)).length;
    moreBtn.hidden = left === 0;
    moreCount.textContent = left > 0 ? `(${left})` : '';
  }

  // Assign src and drop .pending for the next n photos of the active category.
  function revealMore(n: number) {
    const batch = photos.filter((p) => inCat(p) && isPending(p)).slice(0, n);
    batch.forEach((p) => {
      const img = p.querySelector('img') as HTMLImageElement | null;
      if (img && !img.getAttribute('src') && img.dataset.src) img.src = img.dataset.src;
      p.classList.remove('pending');
    });
    if (!reduce && batch.length) {
      animate(batch, {
        opacity: [0, 1], scale: [0.96, 1], duration: 320,
        delay: (_, i) => Math.min(i, 24) * 18, ease: 'outQuart',
      });
    }
    updateMoreBtn();
  }

  moreBtn.addEventListener('click', () => revealMore(BATCH));

  // ===== Gallery filter =====
  function filterGallery(cat: string) {
    currentCat = cat;
    const hideItems: HTMLElement[] = [];
    const showItems: HTMLElement[] = [];
    photos.forEach((p) => {
      // pending photos stay out of the animation — revealMore handles them
      if (isPending(p)) return;
      if (inCat(p)) showItems.push(p); else hideItems.push(p);
    });
    // Always keep at least one batch on screen for the new category.
    const deficit = BATCH - showItems.length;
    if (deficit > 0) revealMore(deficit);
    updateMoreBtn();
    if (reduce) {
      hideItems.forEach((p) => p.classList.add('hide'));
      showItems.forEach((p) => { p.classList.remove('hide'); p.style.opacity = '1'; });
      return;
    }
    // cap stagger so large sets don't accumulate huge delays
    const toHide = hideItems.filter((p) => !p.classList.contains('hide'));
    animate(toHide, {
      opacity: [1, 0], scale: [1, 0.96], duration: 180, delay: (_, i) => Math.min(i, 24) * 12, ease: 'outQuad',
      onComplete: () => hideItems.forEach((p) => p.classList.add('hide')),
    });
    showItems.forEach((p) => p.classList.remove('hide'));
    animate(showItems, { opacity: [0, 1], scale: [0.96, 1], duration: 320, delay: (_, i) => Math.min(i, 24) * 18, ease: 'outQuart' });
  }

  // ===== Category nav =====
  const catBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-btn'));
  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      catBtns.forEach((b) => b.classList.toggle('active', b === btn));
      filterGallery(btn.dataset.cat || 'todas');
    });
  });

  // ===== Lightbox =====
  const lb = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbPh = document.getElementById('lb-ph')!;
  const lbStage = document.getElementById('lb-stage')!;
  const lbMeta = document.getElementById('lb-meta')!;
  const lbCount = document.getElementById('lb-count')!;
  let view: HTMLElement[] = [];
  let pos = 0;
  // Only photos actually on screen — not filtered out, not still pending.
  const visible = () => photos.filter((p) => !p.classList.contains('hide') && !isPending(p));

  function showAt(i: number) {
    if (view.length === 0) return;
    pos = (i + view.length) % view.length;
    const it = view[pos];
    const img = it.querySelector('img');
    const cat = it.querySelector('.photo-cat')?.getAttribute('data-label') || '';
    const full = img ? ((img as HTMLImageElement).getAttribute('src') || (img as HTMLElement).dataset.src) : null;
    if (full) { lbImg.src = full; lbImg.style.display = 'block'; lbPh.style.display = 'none'; }
    else { lbImg.style.display = 'none'; lbPh.style.display = 'flex'; }
    lbMeta.textContent = cat.toUpperCase();
    lbCount.textContent = `${pos + 1} / ${view.length}`;
    if (!reduce) animate(lbStage, { opacity: [0, 1], scale: [0.95, 1], duration: 280, ease: 'outQuart' });
  }
  function openLb(it: HTMLElement) {
    view = visible(); pos = view.indexOf(it);
    lb.classList.add('open'); lb.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
    if (!reduce) animate(lb, { opacity: [0, 1], duration: 280, ease: 'outQuart' }); else lb.style.opacity = '1';
    showAt(pos);
  }
  function closeLb() {
    const done = () => { lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; };
    if (reduce) { done(); return; }
    animate(lb, { opacity: 0, duration: 200, ease: 'outQuart', onComplete: done });
  }
  photos.forEach((p) => p.addEventListener('click', () => openLb(p)));

  updateMoreBtn();
  document.getElementById('lb-close')!.addEventListener('click', closeLb);
  document.getElementById('lb-prev')!.addEventListener('click', () => showAt(pos - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => showAt(pos + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
  window.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') closeLb();
    if (e.key === 'ArrowLeft') showAt(pos - 1);
    if (e.key === 'ArrowRight') showAt(pos + 1);
  });
  let tx = 0;
  lb.addEventListener('touchstart', (e) => (tx = e.changedTouches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 50) showAt(dx > 0 ? pos - 1 : pos + 1); }, { passive: true });
</script>
